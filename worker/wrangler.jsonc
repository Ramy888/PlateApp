{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "platepatch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "platepatch-scan",
      "database_id": "fa734b41-4e82-47c0-9736-6f613e21b7a4",
      "migrations_dir": "migrations"
    }
  ],

  // Generated previews only. A lifecycle rule on the bucket deletes anything
  // under p/ after 24 hours, so expiry is enforced by infrastructure rather
  // than by remembering to call delete.
  "r2_buckets": [
    { "binding": "PREVIEWS", "bucket_name": "platepatch-previews" }
  ],

  // Flux draws the chat reply's picture. Workers AI has no local simulator, so
  // the binding is marked remote: `wrangler dev` then calls the real thing —
  // which costs real money in local dev too. The tests mock it.
  "ai": { "binding": "AI", "remote": true },

  // One instance per device. Quota is a read-modify-write race, and a Durable
  // Object is single-threaded per id, so two phones cannot both spend the last
  // scan.
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }
  ],

  "vars": {
    "MODEL_VISION": "gemini-3.7-flash",
    "MODEL_IMAGE": "gemini-3.1-flash-image",

    // Chat: Gemini writes the words, Workers AI draws the plate. Flux is an
    // order of magnitude cheaper per image than the Gemini image model, which
    // is why the chat reply uses it and the photo-editing preview does not.
    "MODEL_CHAT": "gemini-3.7-flash",
    "MODEL_CHAT_IMAGE": "@cf/black-forest-labs/flux-1-schnell",

    // Optional. When set, Gemini calls route through AI Gateway for logging,
    // cost analytics and a rate ceiling. Empty means call Google directly —
    // the key stays server-side either way.
    "AI_GATEWAY_ID": "",
    "CF_ACCOUNT_ID": "49a2335350fcd5f21a1da7f542176da5",

    "RC_ENTITLEMENT": "platepatch_pro",
    "ANDROID_PACKAGE": "com.platepatch.app",

    // The *web* OAuth client. Every Google ID token must name this as its
    // audience, which is what stops a token minted for some other app being
    // accepted here. Public by design; the client secret is not used at all,
    // because verifying a signature needs Google's public keys, not a secret.
    "GOOGLE_CLIENT_ID": "639333556684-6aqi4fughbj3p264q2lr8325c5j6uug4.apps.googleusercontent.com",

    // Scanning is free for this many days, then it is a subscription.
    // Building a meal by hand is always free and never reaches this Worker.
    "TRIAL_DAYS": "7",
    "PRO_SCANS_PER_MONTH": "30",
    "PRO_PREVIEWS_PER_MONTH": "10"
  },

  // A second deployment for testing on a real phone.
  //
  // Identical code, its own Durable Object namespace, and deliberately no
  // PLAY_INTEGRITY_SA — so a sideloaded build signed with the upload key can
  // register, which it cannot against production. Production keeps attestation
  // enforced; nothing here changes that.
  //
  // It shares the database and the bucket, so a test device is just another
  // device. Delete it when the testing is done:
  //   npx wrangler delete --name platepatch-api-test
  "env": {
    "test": {
      "name": "platepatch-api-test",
      "observability": { "enabled": true, "traces": { "enabled": true } },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "platepatch-scan",
          "database_id": "fa734b41-4e82-47c0-9736-6f613e21b7a4",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PREVIEWS", "bucket_name": "platepatch-previews" }],
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }],
      "vars": {
        "MODEL_VISION": "gemini-3.7-flash",
        "MODEL_IMAGE": "gemini-3.1-flash-image",
        "MODEL_CHAT": "gemini-3.7-flash",
        "MODEL_CHAT_IMAGE": "@cf/black-forest-labs/flux-1-schnell",
        "AI_GATEWAY_ID": "",
        "CF_ACCOUNT_ID": "49a2335350fcd5f21a1da7f542176da5",
        "RC_ENTITLEMENT": "platepatch_pro",
        "ANDROID_PACKAGE": "com.platepatch.app",
        "GOOGLE_CLIENT_ID": "639333556684-6aqi4fughbj3p264q2lr8325c5j6uug4.apps.googleusercontent.com",
        "TRIAL_DAYS": "7",
        "PRO_SCANS_PER_MONTH": "30",
        "PRO_PREVIEWS_PER_MONTH": "10"
      }
    }
  }

  // Secrets, set with `wrangler secret put`:
  //   GEMINI_API_KEY          Google AI Studio key
  //   REVENUECAT_SECRET_KEY   for server-side entitlement checks
  //   PLAY_INTEGRITY_SA       service-account JSON for decodeIntegrityToken
}
