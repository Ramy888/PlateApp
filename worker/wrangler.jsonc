{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "platepatch-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "platepatch-scan",
      "database_id": "fa734b41-4e82-47c0-9736-6f613e21b7a4",
      "migrations_dir": "migrations"
    }
  ],

  // Generated previews only. A lifecycle rule on the bucket deletes anything
  // under p/ after 24 hours, so expiry is enforced by infrastructure rather
  // than by remembering to call delete.
  "r2_buckets": [
    { "binding": "PREVIEWS", "bucket_name": "platepatch-previews" }
  ],

  // One instance per device. Quota is a read-modify-write race, and a Durable
  // Object is single-threaded per id, so two phones cannot both spend the last
  // scan.
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "QuotaCounter" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QuotaCounter"] }
  ],

  "vars": {
    "MODEL_VISION": "gemini-3.7-flash",
    "MODEL_IMAGE": "gemini-3.1-flash-image",

    // Optional. When set, Gemini calls route through AI Gateway for logging,
    // cost analytics and a rate ceiling. Empty means call Google directly —
    // the key stays server-side either way.
    "AI_GATEWAY_ID": "",
    "CF_ACCOUNT_ID": "49a2335350fcd5f21a1da7f542176da5",

    "RC_ENTITLEMENT": "platepatch_pro",
    "ANDROID_PACKAGE": "com.platepatch.app",

    // Free tier. Pro limits live in the Durable Object.
    "FREE_SCANS_PER_WEEK": "3",
    "PRO_SCANS_PER_MONTH": "30",
    "PRO_PREVIEWS_PER_MONTH": "10"
  }

  // Secrets, set with `wrangler secret put`:
  //   GEMINI_API_KEY          Google AI Studio key
  //   REVENUECAT_SECRET_KEY   for server-side entitlement checks
  //   PLAY_INTEGRITY_SA       service-account JSON for decodeIntegrityToken
}
