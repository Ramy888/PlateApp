# Copy to .env and fill in. .env is gitignored.

# Google AI Studio key. Worker-side only.
GEMINI_API_KEY=

# RevenueCat secret key (sk_...). Worker-side only — never in the app.
REVENUECAT_SECRET_KEY=

# RevenueCat *public* SDK keys. These go into the app at build time.
REVENUECAT_ANDROID_KEY=
REVENUECAT_IOS_KEY=
